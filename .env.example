VITE_REGION=your_region_here
VITE_PROJECT=your_project_id_here
VITE_WORKFORCE_ID=your_workforce_id_here

# Optional: set a passphrase to gate access to the app.
# When set, users must enter this passphrase before the UI is shown.
# It is also used to derive the AES-256-GCM key that encrypts localStorage data.
# Leave unset (or empty) for open / local development deployments.
# VITE_ACCESS_PASSPHRASE=your_passphrase_here
