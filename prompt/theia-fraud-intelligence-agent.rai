    {
      "chain_id": "95022fef-5e65-4377-a00a-58a05762b211",
      "action_behaviour": "never-ask",
      "title": "Custom Risk Scoring Engine for Fraud Detection",
      "description": "A comprehensive fraud risk scoring engine that trains ensemble models (Random Forest, XGBoost, Logistic Regression) with Bayesian calibration and uncertainty quantification. Performs end-to-end model training and batch scoring on large fraud datasets (PaySim, MomtSim, IEEE-CIS Fraud, credit card fraud). Outputs risk scores with confidence intervals, uncertainty-weighted predictions, feature importance rankings, flagged high-risk transactions, and detailed performance metrics (ROC-AUC, PR-AUC, F1-score). Supports custom model configurations, calibration methods (Platt scaling, isotonic regression), and automatic threshold optimization via Youden's J statistic.",
      "project": "38c1fd02-ab72-445f-bba9-2e712bb34daa",
      "region": "d7b62b",
      "wait_for_completion": true
    },
