      "action_behaviour": "never-ask",
      "title": "Entity Resolution and Fraud Network Analysis",
      "description": "Performs flexible entity resolution and fraud network analysis on large datasets (PaySim, MomtSim, IEEE-CIS, MLG credit card fraud). Detects fraud rings, synthetic identities, and relationship networks using configurable clustering algorithms (similarity-based or graph-based), graph analysis metrics, and customizable risk propagation models. Supports multiple input formats and generates comprehensive network analysis with entity risk scores, relationship chains, and visualization data.",
      "project": "38c1fd02-ab72-445f-bba9-2e712bb34daa",
      "region": "d7b62b",
      "wait_for_completion": true
